{
  "name": "cerebro-operativa-cf-portability-lab",
  "compatibility_date": "2026-11-18",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
