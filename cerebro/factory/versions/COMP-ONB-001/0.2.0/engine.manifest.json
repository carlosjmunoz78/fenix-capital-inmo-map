  "policies": [
    "deterministic_before_AI",
    "zero_new_cost_by_default",
    "preserve_existing_contracts",
    "deny_cross_company",
    "strict_step_order",
    "evidence_required_for_completion",
    "canonical_human_exception_codes_only",
