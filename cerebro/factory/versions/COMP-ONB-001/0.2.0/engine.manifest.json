  "owner": "CEREBRO Platform",
  "permissions": [
    "read/transition COMP-REG lifecycle REGISTERED->ONBOARDING",
    "use TENANT-001 guard",
    "write local PREPROD onboarding state",
    "no credentials",
    "no downstream auto-execution",
    "no PROD execution"
