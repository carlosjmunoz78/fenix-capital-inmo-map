  "inputs": [
    "authenticated_company_id",
    "target_company_id",
    "evidence_ref",
    "blocker_code",
    "resolution_ref"
  ],
  "jobs": [],
  "knowledge_sources": [
    "COMP-REG-001 canonical company identity",
    "TENANT-001 isolation context",
    "Engine Registry operational status"
  ],
  "layer": "L8",
  "name": "Company Onboarding Orchestrator",
