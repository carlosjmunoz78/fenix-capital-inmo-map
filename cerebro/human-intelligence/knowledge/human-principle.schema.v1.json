{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://human-intelligence/human-principle/v1",
  "title": "CEREBRO HumanPrinciple V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principle_id",
    "company_id",
    "engine_id",
    "environment",
    "version",
    "domain",
    "summary",
    "source_refs",
    "activation_signals",
    "recommended_behavior",
    "avoid",
    "evidence",
    "status"
  ],
  "properties": {
    "principle_id": {"type": "string", "pattern": "^HIP-[A-Z0-9_-]{4,80}$"},
    "company_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "engine_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "environment": {"enum": ["LAB", "PREPROD", "PROD"]},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "domain": {"type": "string", "minLength": 2, "maxLength": 160},
    "subdomain": {"type": ["string", "null"], "maxLength": 160},
    "summary": {"type": "string", "minLength": 5, "maxLength": 2000},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "rights_status", "provenance_ref"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 240},
          "source_type": {"enum": ["PAPER", "STANDARD", "GUIDELINE", "LEGAL", "DATASET", "BOOK", "OPERATIONAL", "OTHER"]},
          "rights_status": {"enum": ["FULLTEXT_ALLOWED", "REFERENCE_ONLY", "CONDITIONAL", "BLOCKED", "UNKNOWN"]},
          "provenance_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "license": {"type": ["string", "null"], "maxLength": 240}
        }
      }
    },
    "activation_signals": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 2, "maxLength": 500}},
    "context": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "recommended_behavior": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 2, "maxLength": 1000}},
    "avoid": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 2, "maxLength": 1000}},
    "exceptions": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "counterexamples": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "misapplication_risks": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
    "scenario_refs": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 240}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "method_quality", "replication", "directness", "external_validity", "currency", "confidence"],
      "properties": {
        "evidence_type": {"enum": ["META_ANALYSIS", "SYSTEMATIC_REVIEW", "STANDARD_GUIDELINE", "EXPERIMENTAL", "OBSERVATIONAL", "LONGITUDINAL", "QUALITATIVE", "BENCHMARK_DATASET", "LEGAL_REGULATORY", "OPERATIONAL_PRECEDENT", "BOOK_EXPERT", "HYPOTHESIS"]},
        "method_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "replication": {"type": "number", "minimum": 0, "maximum": 1},
        "directness": {"type": "number", "minimum": 0, "maximum": 1},
        "external_validity": {"type": "number", "minimum": 0, "maximum": 1},
        "currency": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "contradiction_refs": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 240}},
    "expected_metrics": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 240}},
    "status": {"enum": ["SOURCE", "CANDIDATE", "VALIDATED", "CANONICAL", "LIMITED", "REJECTED", "SUPERSEDED"]},
    "prod_authorized": {"const": false},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  }
}
