{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"cerebro://media-studio/v2/knowledge-item.schema.json",
  "title":"Universal Media Studio Knowledge Item",
  "type":"object",
  "required":["knowledge_id","role_ids","department_ids","topic","horizon","source","evidence","confidence","status","version","observed_at"],
  "properties":{
    "knowledge_id":{"type":"string"},
    "role_ids":{"type":"array","items":{"type":"string"}},
    "department_ids":{"type":"array","items":{"type":"string"}},
    "topic":{"type":"string","minLength":1},
    "horizon":{"enum":["NOW","EMERGING","COMING","FRONTIER"]},
    "source":{"type":"object","required":["source_id","source_type","publisher","uri"],"properties":{"source_id":{"type":"string"},"source_type":{"enum":["STANDARD","OFFICIAL_DOC","PAPER","BOOK","COURSE","CASE_STUDY","TOOL_DOC","BENCHMARK","PRODUCTION_POSTMORTEM","INTERNAL_RESULT"]},"publisher":{"type":"string"},"uri":{"type":"string"},"license_or_usage_notes":{"type":"string"}}},
    "evidence":{"type":"object","required":["summary","provenance_ref"],"properties":{"summary":{"type":"string"},"provenance_ref":{"type":"string"},"claims":{"type":"array","items":{"type":"string"}},"contradictions":{"type":"array","items":{"type":"string"}}}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "status":{"enum":["DISCOVERED","VERIFIED","BENCHMARK_REQUIRED","ACCEPTED","REJECTED","SUPERSEDED"]},
    "version":{"type":"string"},
    "observed_at":{"type":"string"},
    "next_review_at":{"type":["string","null"]},
    "supersedes":{"type":["string","null"]},
    "old_vs_new_ref":{"type":["string","null"]},
    "tribunal_ref":{"type":["string","null"]}
  },
  "additionalProperties":false
}
