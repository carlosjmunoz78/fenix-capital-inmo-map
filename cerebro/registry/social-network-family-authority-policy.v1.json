{
  "schema_version":"1.0.0",
  "policy_id":"CEREBRO-SOCIAL-NETWORK-FAMILY-AUTHORITY-POLICY-V1",
  "engine_id":"FACT-001",
  "company_id":"GLOBAL",
  "environment":"PREPROD",
  "version":"1.0.0",
  "effective_date":"2026-10-22",
  "canonical_rule":"Every material SOCIAL_NETWORK × BUSINESS_FAMILY combination is an independent logical operating unit with its own dedicated team, orchestrator binding, supervisor and independent tribunal. Corporate or company-wide social layers may aggregate and coordinate but may never replace unit authority.",
  "unit_identity":{
    "unit_id":"UNIT-{NETWORK}-{BUSINESS_FAMILY}-{VERSION}",
    "team_id":"TEAM-{NETWORK}-{BUSINESS_FAMILY}-{VERSION}",
    "orchestrator_id":"ORCH-{NETWORK}-{BUSINESS_FAMILY}-{VERSION}",
    "supervisor_id":"SUP-{NETWORK}-{BUSINESS_FAMILY}-{VERSION}",
    "tribunal_id":"TRIBUNAL-{NETWORK}-{BUSINESS_FAMILY}-{VERSION}"
  },
  "factory_must_create":[
    "manifest",
    "team_contract",
    "roles_and_subagents",
    "orchestrator_binding",
    "supervisor_contract",
    "tribunal_contract",
    "knowledge_namespace",
    "learning_namespace",
    "evaluation_namespace",
    "autonomy_ledger",
    "observability_scope",
    "cost_scope",
    "backup_scope",
    "rollback_scope",
    "rebuild_scope"
  ],
  "authority_invariants":{
    "dedicated_team":true,
    "dedicated_orchestrator_binding":true,
    "dedicated_supervisor":true,
    "dedicated_tribunal":true,
    "shared_runtime_allowed":true,
    "shared_workers_allowed":true,
    "shared_event_bus_allowed":true,
    "shared_observability_infrastructure_allowed":true,
    "shared_scout_infrastructure_allowed":true,
    "shared_final_decision_authority_allowed":false,
    "cross_network_autonomy_inheritance_allowed":false,
    "cross_family_autonomy_inheritance_allowed":false
  },
  "corporate_social_layer":{
    "allowed":true,
    "purpose":["aggregate_reporting","cross_network_coordination","shared_research_deduplication","portfolio_view","cross_network_signal_routing"],
    "may_replace_unit_team":false,
    "may_replace_unit_orchestrator":false,
    "may_replace_unit_supervisor":false,
    "may_replace_unit_tribunal":false,
    "may_certify_unit_autonomy":false,
    "may_bypass_unit_gate":false,
    "may_publish_on_behalf_of_unit_without_unit_gate":false
  },
  "company_overlay_rule":"A company, brand, territory, persona and campaign instantiate overlays inside the matching NETWORK × BUSINESS_FAMILY unit. They do not create a generic social authority that supersedes the specialized unit.",
  "tribunal_rule":"The tribunal is unit-specific and independent from both orchestrator and supervisor. It judges autonomy promotions, material policy changes, high-impact capability changes, spend authority and PROD promotion using evidence belonging to the exact NETWORK × BUSINESS_FAMILY unit.",
  "cross_unit_learning":{
    "share_generalized_validated_patterns":true,
    "share_research_infrastructure":true,
    "share_private_company_data":false,
    "share_credentials":false,
    "share_certification":false,
    "receiving_unit_validation_required":true
  },
  "examples":[
    "FACEBOOK::FINANCIAL_REAL_ESTATE",
    "INSTAGRAM::FINANCIAL_REAL_ESTATE",
    "LINKEDIN::FINANCIAL_REAL_ESTATE",
    "FACEBOOK::TECH_PRODUCTS_AI",
    "INSTAGRAM::TECH_PRODUCTS_AI",
    "LINKEDIN::TECH_PRODUCTS_AI"
  ],
  "forbidden":[
    "ONE_GLOBAL_SOCIAL_TEAM_AS_REPLACEMENT_FOR_SPECIALIZED_UNITS",
    "ONE_GLOBAL_SOCIAL_SUPERVISOR_AS_FINAL_AUTHORITY",
    "ONE_GLOBAL_SOCIAL_TRIBUNAL_FOR_ALL_NETWORKS_AND_FAMILIES",
    "CROSS_NETWORK_AUTONOMY_PROMOTION",
    "CROSS_FAMILY_AUTONOMY_PROMOTION",
    "SHARED_CERTIFICATION_WITHOUT_UNIT_SPECIFIC_EVIDENCE"
  ]
}
