    "manual_suppression",
    "complaint",
    "reply_stop",
    "legal_hold",
    "frequency_cap",
    "permission_denied"
  ],
  "human_escalation_triggers": [
    "reply_received",
    "positive_intent",
    "uncertain_intent",
    "high_value_lead",
    "sensitive_financial_case",
