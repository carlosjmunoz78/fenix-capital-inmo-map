{
  "schema_version": "1.2.0",
  "status": "DEFINED_NOT_BUILT",
  "scope": "GCP_READ_ONLY_DISCOVERY_COMMAND_CATALOG",
  "environment": "SCAFFOLD",
  "engine_id": "INT-001",
  "execution_mode": "PLAN_ONLY",
  "additional_cost_target_eur": 0,
  "prod_writes": false,
  "autonomous_prod": false,
  "trading_access": false,
  "known_project_ids": [
    "fenix-trading-lab",
    "fenix-capital-455809",
    "fenix-inmobiliaria",
    "fenix-capital-make-web-y-seo"
  ],
  "required_inventory_domains": [
    "projects",
    "enabled_apis",
    "cloud_run",
    "cloud_functions",
    "compute",
    "jobs",
    "scheduler",
    "pubsub",
    "storage",
    "databases",
    "artifact_registry",
    "service_accounts_and_iam",
    "secret_references",
    "networking",
    "logging_monitoring",
    "billing_cost",
    "regions",
    "deployments",
    "resource_consumers"
  ],
  "command_policy": {
    "mode": "READ_ONLY_FIRST",
    "generator_only": true,
    "execute_commands": false,
    "requires_authenticated_gcloud_or_authorized_connector": true,
    "secrets_policy": "REFERENCES_ONLY",
    "least_privilege": true,
    "parameter_tokens": ["${PROJECT_ID}", "${LOCATION}"],
    "allowed_read_verbs": ["describe", "list", "search-all-resources", "get-iam-policy"],
    "forbidden_mutating_verbs": [
      "create",
      "update",
      "delete",
      "deploy",
      "set",
      "add-iam-policy-binding",
      "remove-iam-policy-binding",
      "enable",
      "disable",
      "start",
      "stop",
      "restart",
      "patch",
      "write"
    ]
  },
  "domain_commands": [
    {"domain":"projects","commands":["gcloud projects describe ${PROJECT_ID} --format=json"]},
    {"domain":"enabled_apis","commands":["gcloud services list --enabled --project=${PROJECT_ID} --format=json"]},
    {"domain":"cloud_run","commands":["gcloud run services list --project=${PROJECT_ID} --platform=managed --format=json"]},
    {"domain":"cloud_functions","commands":["gcloud functions list --project=${PROJECT_ID} --format=json"]},
    {"domain":"compute","commands":["gcloud compute instances list --project=${PROJECT_ID} --format=json"]},
    {"domain":"jobs","commands":["gcloud run jobs list --project=${PROJECT_ID} --format=json"]},
    {"domain":"scheduler","commands":["gcloud scheduler locations list --project=${PROJECT_ID} --format=json","gcloud scheduler jobs list --project=${PROJECT_ID} --location=${LOCATION} --format=json"],"expansion_policy":"derive LOCATION values only from the read-only locations list for the same PROJECT_ID, then emit one jobs list command per returned location; never use ambient gcloud scheduler/location defaults"},
    {"domain":"pubsub","commands":["gcloud pubsub topics list --project=${PROJECT_ID} --format=json","gcloud pubsub subscriptions list --project=${PROJECT_ID} --format=json"]},
    {"domain":"storage","commands":["gcloud storage buckets list --project=${PROJECT_ID} --format=json"]},
    {"domain":"databases","commands":["gcloud sql instances list --project=${PROJECT_ID} --format=json","gcloud firestore databases list --project=${PROJECT_ID} --format=json"]},
    {"domain":"artifact_registry","commands":["gcloud artifacts repositories list --project=${PROJECT_ID} --format=json"]},
    {"domain":"service_accounts_and_iam","commands":["gcloud iam service-accounts list --project=${PROJECT_ID} --format=json","gcloud projects get-iam-policy ${PROJECT_ID} --format=json"]},
    {"domain":"secret_references","commands":["gcloud secrets list --project=${PROJECT_ID} --format=json"],"safety_note":"metadata only; never access secret payloads or versions"},
    {"domain":"networking","commands":["gcloud compute networks list --project=${PROJECT_ID} --format=json","gcloud compute firewall-rules list --project=${PROJECT_ID} --format=json"]},
    {"domain":"logging_monitoring","commands":["gcloud logging sinks list --project=${PROJECT_ID} --format=json","gcloud monitoring policies list --project=${PROJECT_ID} --format=json"]},
    {"domain":"billing_cost","commands":["gcloud billing projects describe ${PROJECT_ID} --format=json"],"safety_note":"billing linkage only; cost amounts require an already-authorized billing export/API and must not be invented"},
    {"domain":"regions","commands":["gcloud compute regions list --project=${PROJECT_ID} --format=json"]},
    {"domain":"deployments","commands":["gcloud deployment-manager deployments list --project=${PROJECT_ID} --format=json"],"safety_note":"optional legacy surface; service-specific deployment state remains captured by its own read-only domain commands"},
    {"domain":"resource_consumers","commands":["gcloud asset search-all-resources --scope=projects/${PROJECT_ID} --format=json"],"safety_note":"use only if Cloud Asset Inventory access already exists; do not enable APIs from this catalog"}
  ],
  "training_guard": {
    "training_project_id": "fenix-trading-lab",
    "resource_ownership_status": "UNKNOWN_REQUIRES_AUDIT",
    "separate_training_from_trading_before_any_write": true,
    "trading_mutation_forbidden": true
  },
  "discovery_strategy": [
    "PROJECT_METADATA",
    "ENABLED_SERVICES",
    "ASSET_INVENTORY_IF_AVAILABLE",
    "SERVICE_SPECIFIC_READ_ONLY_LIST_DESCRIBE",
    "DEPENDENCY_CLASSIFICATION",
    "EVIDENCE_CAPTURE"
  ]
}
