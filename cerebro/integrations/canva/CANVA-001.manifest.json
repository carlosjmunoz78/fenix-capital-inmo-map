    "publication_authority_belongs_to_origin_engine": true,
    "paid_plan_features_allowed_when_included": true,
    "no_extra_spend_without_money_limit_gate": true,
    "use_brand_kit_when_applicable": true,
    "retain_editable_masters": true,
    "native_platform_adaptation_required": true,
    "license_and_commercial_use_qa_required": true,
    "accessibility_qa_required": true,
    "visual_qa_required": true,
    "learning_feedback_required": true,
    "no_captcha_mfa_or_anti_bot_bypass": true
