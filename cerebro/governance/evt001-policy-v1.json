{
  "schema_version": "1.0.0",
  "engine_id": "EVT-001",
  "policy": "EVENT_BUS_PREPROD_FAIL_CLOSED",
  "environment": "PREPROD",
  "allow": ["PUBLISH", "LIST_CONTEXT", "LIST_COMPANY", "DELIVER_CONTEXT", "REPLAY_VERIFY"],
  "deny": ["PROD", "CROSS_COMPANY", "UNKNOWN_OPERATION", "UNBOUNDED_RETRY", "TRADING_ACCESS"],
  "permission": "SCOPED_CONTEXT_ONLY",
  "fail_closed": true,
  "source_of_truth_must_not_be_duplicated": true,
  "prod_execution_authorized": false,
  "prod_write_authorized": false,
  "trading_access": false,
  "additional_cost_eur": 0,
  "human_required": ["LEGAL_REQUIRED", "SIGNATURE_REQUIRED", "LOW_CONFIDENCE", "HIGH_RISK", "POLICY_CONFLICT", "SECURITY_INCIDENT", "MONEY_LIMIT", "CUSTOMER_HUMAN_REQUEST"],
  "invariant": "EVT-001 reuses the existing persistent event runtime and may not bypass PREPROD or company isolation"
}
