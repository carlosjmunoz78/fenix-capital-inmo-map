{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/wordpress-company-config.v1",
  "title": "CEREBRO WordPress Company Config",
  "type": "object",
  "required": [
    "company_id",
    "version",
    "brand",
    "primary_domain",
    "wordpress_base_url",
    "public_email",
    "lead_endpoint",
    "providers",
    "audiences",
    "newsletter_streams",
    "policies"
  ],
  "properties": {
    "company_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "primary_domain": {"type": "string", "minLength": 1},
    "wordpress_base_url": {"type": "string", "pattern": "^https://"},
    "public_email": {"type": "string", "minLength": 3},
    "lead_endpoint": {"type": "string", "minLength": 1},
    "providers": {"type": "object"},
    "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "newsletter_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream_id", "audience", "cadence", "send_enabled"],
        "properties": {
          "stream_id": {"type": "string", "minLength": 1},
          "audience": {"type": "string", "minLength": 1},
          "cadence": {"enum": ["WEEKLY", "MONTHLY", "MANUAL"]},
          "send_enabled": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "marketing_consent_required",
        "prod_writes_default",
        "additional_cost_eur_target",
        "wpvibe_required",
        "make_required"
      ],
      "properties": {
        "marketing_consent_required": {"const": true},
        "prod_writes_default": {"const": "DENY"},
        "additional_cost_eur_target": {"const": 0},
        "wpvibe_required": {"const": false},
        "make_required": {"const": false}
      }
    }
  }
}
