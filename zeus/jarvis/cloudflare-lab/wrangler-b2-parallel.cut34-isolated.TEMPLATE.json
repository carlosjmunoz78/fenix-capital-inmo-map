{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "cerebro-jarvis-cut32-lab-eu",
  "main": "./worker-b2-device-probe.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "vars": {
    "JARVIS_ENVIRONMENT": "LAB",
    "JARVIS_ACCESS_PROBE_ENABLED": "false",
    "JARVIS_B2_DEVICE_ENABLED": "false",
    "JARVIS_B2_ENROLLMENT_ENABLED": "false",
    "JARVIS_B2_B3_LIVE_ENABLED": "false",
    "JARVIS_GATEWAY_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "JARVIS_LAB_DB",
      "database_name": "cerebro-jarvis-cut33-lab-eu",
      "database_id": "CUT34_UNPROVISIONED_DO_NOT_DEPLOY",
      "preview_database_id": "jarvis-cut34-isolated-local"
    }
  ]
}
