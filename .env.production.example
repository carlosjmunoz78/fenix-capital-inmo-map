# Fénix Capital APP PROD — example only. Never commit real secrets.
# These are the only frontend runtime variables currently consumed by src/supabase.ts.
VITE_FENIX_ENV=prod
VITE_SUPABASE_URL=https://<prod-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<prod-publishable-key>

# Auth storage namespaces are fixed in code to prevent accidental PRE-PROD/PROD reuse:
# PROD: fenix-prod-auth-v1
# PRE-PROD: fenix-preprod-auth-v2
#
# Production Edge Functions are also fixed by the runtime contract and must exist
# independently of PRE-PROD using names without the -test suffix:
# fenix-app-gateway
# fenix-ana-api
# fenix-ana-knowledge
# fenix-ana-canonical
# fenix-evidence-api
# fenix-memory-api
# fenix-b2b-actions
